generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Explicit, otherwise it is inferred from tsconfig.json (which isn't there during the Docker install)
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String  @id @default(cuid())
  firstName  String
  lastName   String
  email      String  @unique
  password   String
  role       Role    @default(USER)
  isVerified Boolean @default(false)

  // Encrypted with AES-256-GCM (see shared/utils/crypto.ts)
  totpSecret       String?
  totpEnabled      Boolean @default(false)
  // Last accepted TOTP time step, so a code can't be replayed
  totpLastUsedStep Int?

  LoginHistory       LoginHistory[]
  verificationCodes  VerificationCode[]
  sessions           Session[]
  recoveryCodes      RecoveryCode[]
  passkeys           Passkey[]
  webauthnChallenges WebAuthnChallenge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model LoginHistory {
  id         String   @id @default(cuid())
  userId     String
  ipAddress  String?
  userAgent  String?
  device     String?
  location   String?
  loginTime  DateTime @default(now())
  successful Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, loginTime(sort: Desc)])
}

enum CodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// Short-lived one-time codes sent by email. Only an HMAC of the code is stored.
model VerificationCode {
  id        String      @id @default(cuid())
  userId    String
  purpose   CodePurpose
  codeHash  String
  attempts  Int         @default(0)
  expiresAt DateTime
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // At most one active code per user and purpose
  @@unique([userId, purpose])
}

// A signed-in device. Its refresh token is opaque, stored hashed, and rotated on every use.
model Session {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String
  // Hash of the token that was rotated out, used to detect refresh token reuse
  previousTokenHash String?
  rotatedAt         DateTime?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One-time backup codes for 2FA, for when the authenticator app is lost. Stored as HMACs.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// Transactional outbox: background jobs written in the same transaction as the change
// that caused them, then delivered (with retries) by the outbox worker
model OutboxMessage {
  id          String       @id @default(cuid())
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  lockedAt    DateTime?
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())

  @@index([status, availableAt])
}

// A WebAuthn credential (passkey). Only the public key is stored.
model Passkey {
  // Credential ID, base64url
  id         String    @id
  userId     String
  publicKey  Bytes
  // Signature counter reported by the authenticator, used to spot cloned keys
  counter    BigInt    @default(0)
  transports String[]
  // singleDevice or multiDevice (synced, e.g. iCloud Keychain, Google Password Manager)
  deviceType String
  backedUp   Boolean
  name       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum WebAuthnCeremony {
  REGISTRATION
  AUTHENTICATION
}

// Challenge sent to the browser for one WebAuthn ceremony; single use, short-lived
model WebAuthnChallenge {
  id        String           @id @default(cuid())
  challenge String           @unique
  ceremony  WebAuthnCeremony
  // Set for registration; sign-in challenges aren't tied to a user (usernameless)
  userId    String?
  expiresAt DateTime
  createdAt DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}
