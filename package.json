{
  "name": "node-authentication-template",
  "version": "3.1.0",
  "description": "Secure authentication API for Node.js: email verification, TOTP 2FA with recovery codes, rotating refresh tokens, session management, Argon2id, Prisma and PostgreSQL",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Khaled Saeed (https://github.com/KhaledSaeed18)",
  "homepage": "https://github.com/KhaledSaeed18/node-authentication-template#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KhaledSaeed18/node-authentication-template.git"
  },
  "bugs": {
    "url": "https://github.com/KhaledSaeed18/node-authentication-template/issues"
  },
  "keywords": [
    "authentication",
    "auth",
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "jwt",
    "refresh-token",
    "2fa",
    "totp",
    "argon2",
    "sessions",
    "api"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@1.22.22",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentation.ts src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./dist/instrumentation.js dist/server.js",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:cleanup": "tsx src/scripts/cleanup.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/instrumentation": "^7.10.0",
    "@scalar/express-api-reference": "^0.10.28",
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.16",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "openid-client": "^6.8.8",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "resolutions": {
    "mysql2": "^3.24.5"
  }
}
