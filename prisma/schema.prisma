generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Explicit, otherwise it is inferred from tsconfig.json (which isn't there during the Docker install)
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(cuid())
  firstName    String
  lastName     String
  email        String  @unique
  password     String
  role         Role    @default(USER)
  isVerified   Boolean @default(false)
  // New address waiting to be confirmed with an EMAIL_CHANGE code
  pendingEmail String?

  // Encrypted with AES-256-GCM (see shared/utils/crypto.ts)
  totpSecret       String?
  totpEnabled      Boolean @default(false)
  // Last accepted TOTP time step, so a code can't be replayed
  totpLastUsedStep Int?

  LoginHistory       LoginHistory[]
  verificationCodes  VerificationCode[]
  sessions           Session[]
  recoveryCodes      RecoveryCode[]
  passkeys           Passkey[]
  webauthnChallenges WebAuthnChallenge[]
  securityEvents     SecurityEvent[]
  authorizationCodes AuthorizationCode[]
  oauthConsents      OAuthConsent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model LoginHistory {
  id         String   @id @default(cuid())
  userId     String
  ipAddress  String?
  userAgent  String?
  device     String?
  location   String?
  loginTime  DateTime @default(now())
  successful Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, loginTime(sort: Desc)])
}

enum CodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

// Short-lived one-time codes sent by email. Only an HMAC of the code is stored.
model VerificationCode {
  id        String      @id @default(cuid())
  userId    String
  purpose   CodePurpose
  codeHash  String
  attempts  Int         @default(0)
  expiresAt DateTime
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // At most one active code per user and purpose
  @@unique([userId, purpose])
}

// A signed-in device. Its refresh token is opaque, stored hashed, and rotated on every use.
model Session {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String
  // Hash of the token that was rotated out, used to detect refresh token reuse
  previousTokenHash String?
  rotatedAt         DateTime?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?

  // Set for sessions created through OpenID Connect: the client and the granted scopes
  clientId String?
  scope    String?

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One-time backup codes for 2FA, for when the authenticator app is lost. Stored as HMACs.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// Transactional outbox: background jobs written in the same transaction as the change
// that caused them, then delivered (with retries) by the outbox worker
model OutboxMessage {
  id          String       @id @default(cuid())
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  lockedAt    DateTime?
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())

  @@index([status, availableAt])
}

// A WebAuthn credential (passkey). Only the public key is stored.
model Passkey {
  // Credential ID, base64url
  id         String    @id
  userId     String
  publicKey  Bytes
  // Signature counter reported by the authenticator, used to spot cloned keys
  counter    BigInt    @default(0)
  transports String[]
  // singleDevice or multiDevice (synced, e.g. iCloud Keychain, Google Password Manager)
  deviceType String
  backedUp   Boolean
  name       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum WebAuthnCeremony {
  REGISTRATION
  AUTHENTICATION
}

// Challenge sent to the browser for one WebAuthn ceremony; single use, short-lived
model WebAuthnChallenge {
  id        String           @id @default(cuid())
  challenge String           @unique
  ceremony  WebAuthnCeremony
  // Set for registration; sign-in challenges aren't tied to a user (usernameless)
  userId    String?
  expiresAt DateTime
  createdAt DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Asymmetric keys that sign access tokens (ES256). Public keys are published at
// /.well-known/jwks.json so other services can verify tokens without any secret.
model SigningKey {
  // The "kid" in token headers
  id         String    @id
  algorithm  String    @default("ES256")
  // Public key as a JWK
  publicJwk  Json
  // PKCS#8 PEM, encrypted with a key derived from ENCRYPTION_KEY
  privateKey String
  createdAt  DateTime  @default(now())
  // Set when a newer key takes over; the key stays published until its tokens expire
  retiredAt  DateTime?
}

// Append-only log of security-relevant account events, shown to users as their account
// activity (sign-in attempts themselves are in LoginHistory)
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// An application allowed to use this service as its OpenID Connect provider
model OAuthClient {
  // client_id
  id           String   @id
  name         String
  // SHA-256 of the client secret; null for public clients (SPAs, mobile apps), which rely on PKCE
  secretHash   String?
  // Exact redirect URIs; anything else is refused
  redirectUris String[]
  // Scopes this client may request
  scopes       String[]
  // Trusted first-party apps skip the consent step
  firstParty   Boolean  @default(false)
  createdAt    DateTime @default(now())

  interactions       OAuthInteraction[]
  authorizationCodes AuthorizationCode[]
  consents           OAuthConsent[]
  sessions           Session[]
}

// An authorization request waiting for the user to sign in (and possibly consent)
model OAuthInteraction {
  id            String   @id @default(cuid())
  clientId      String
  redirectUri   String
  scope         String
  state         String?
  nonce         String?
  codeChallenge String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// Single-use authorization code (stored hashed), exchanged at the token endpoint
model AuthorizationCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  clientId      String
  userId        String
  redirectUri   String
  scope         String
  nonce         String?
  codeChallenge String
  authTime      DateTime
  expiresAt     DateTime
  usedAt        DateTime?
  // Session created by the exchange; revoked if the code is ever presented again
  sessionId     String?
  createdAt     DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Scopes a user has already approved for a third-party client
model OAuthConsent {
  userId    String
  clientId  String
  scopes    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([userId, clientId])
}
