# Server
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
BASE_URL=/api
API_VERSION=v1
# Comma separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Set when running behind a proxy/load balancer: true, a hop count (e.g. 1) or trusted IPs
TRUST_PROXY=false

# Security
SALT_ROUNDS=12

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME

# JWT (at least 32 characters each, e.g. `openssl rand -base64 48`)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Email (Gmail over OAuth2)
USER_EMAIL=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
