generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String @id @default(cuid())
  firstName String
  lastName  String
  email     String @unique
  password  String
  role      Role   @default(USER)
  isVerified Boolean @default(false)

  totpSecret String?
  totpEnabled Boolean @default(false)

  LoginHistory      LoginHistory[]
  verificationCodes VerificationCode[]
  sessions          Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model LoginHistory {
  id         String   @id @default(cuid())
  userId     String
  ipAddress  String?
  userAgent  String?
  device     String?
  location   String?
  loginTime  DateTime @default(now())
  successful Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, loginTime(sort: Desc)])
}

enum CodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// Short-lived one-time codes sent by email. Only an HMAC of the code is stored.
model VerificationCode {
  id        String      @id @default(cuid())
  userId    String
  purpose   CodePurpose
  codeHash  String
  attempts  Int         @default(0)
  expiresAt DateTime
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // At most one active code per user and purpose
  @@unique([userId, purpose])
}

// A signed-in device. Its refresh token is opaque, stored hashed, and rotated on every use.
model Session {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String
  // Hash of the token that was rotated out, used to detect refresh token reuse
  previousTokenHash String?
  rotatedAt         DateTime?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

