# Server
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
BASE_URL=/api
API_VERSION=v1
# Comma separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Passkeys: the domain they are bound to, and the front-end origins allowed to use them
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000
# Set when running behind a proxy/load balancer: true, a hop count (e.g. 1) or trusted IPs
TRUST_PROXY=false
# Optional: share rate limit counters between instances
# REDIS_URL=redis://localhost:6379

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME

# JWT signing secret for access tokens (at least 32 characters, e.g. `openssl rand -base64 48`)
JWT_SECRET=
JWT_ISSUER=node-auth
JWT_AUDIENCE=node-auth-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# 32 random bytes, base64 (`openssl rand -base64 32`). Protects one-time codes and 2FA secrets.
ENCRYPTION_KEY=

# App name shown in emails and authenticator apps
APP_NAME=Node Auth
# Login history older than this is removed by `yarn db:cleanup`
LOGIN_HISTORY_RETENTION_DAYS=90

# Background jobs (emails, notices) go through a database outbox. The worker runs in the
# API process by default; set to false when running `node dist/scripts/worker.js` separately.
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000

# Interactive API docs at /docs (default: on, except in production)
# API_DOCS_ENABLED=true

# Email: console (log only) | smtp | gmail
MAIL_TRANSPORT=console
MAIL_FROM=Node Auth <no-reply@example.com>

# SMTP (MAIL_TRANSPORT=smtp), works with SES, Postmark, Mailgun, Mailpit, ...
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Gmail over OAuth2 (MAIL_TRANSPORT=gmail)
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
